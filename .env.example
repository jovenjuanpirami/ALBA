# Supabase — el service role key SOLO vive en el servidor. Nunca con prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — correo de confirmación de waitlist
RESEND_API_KEY=
# Para probar: "Alba <onboarding@resend.dev>" (solo te llega a ti).
# Para lanzar: un dominio verificado en Resend, o los correos se van a spam.
RESEND_FROM="Alba <onboarding@resend.dev>"
RESEND_REPLY_TO=juanpi@artu.ai

# Analytics opcionales. Vercel Web Analytics no necesita variable: se activa al deployar.
# Si faltan estos IDs no se inyecta nada y la tabla `events` sigue siendo la fuente de verdad.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Dashboard interno: /admin?token=...
ADMIN_DASHBOARD_TOKEN=
