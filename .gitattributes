# Normaliza finales de línea: LF en el repo, lo que corresponda en cada máquina.
* text=auto eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff2 binary
.thumbnail binary

# El lockfile no aporta nada en los diffs de un PR.
package-lock.json linguist-generated=true -diff
